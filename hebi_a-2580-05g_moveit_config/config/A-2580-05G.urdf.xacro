<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="A-2580-05G">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import A-2580-05G urdf file -->
    <xacro:include filename="$(find hebi_description)/urdf/kits/A-2580-05G.urdf.xacro" />

    <!-- Import control_xacro -->
    <xacro:include filename="A-2580-05G.ros2_control.xacro" />


    <xacro:A-2580-05G_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
